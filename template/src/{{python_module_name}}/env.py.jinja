"""Environment detection and .env file loading.

Usage:
    from {{ python_module_name }}.env import current_env, is_dev, is_prod, load_dotenv

    load_dotenv()                # loads .env from project root
    print(current_env())         # "dev", "prod", etc.
    if is_dev():
        print("Running in dev")
"""

from __future__ import annotations

import os
from pathlib import Path


def load_dotenv(env_file: str | Path | None = None) -> None:
    """Load environment variables from a .env file.

    Searches upward from CWD for .env if no path given.
    Does NOT override existing env vars.
    """
    if env_file is None:
        env_file = _find_dotenv()
    if env_file is None:
        return

    path = Path(env_file)
    if not path.exists():
        return

    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        value = value.strip().strip("'\"")
        if key not in os.environ:
            os.environ[key] = value


def current_env() -> str:
    """Return the current environment name. Defaults to 'dev'."""
    return os.environ.get("ENVIRONMENT", "dev").lower()


def is_dev() -> bool:
    return current_env() == "dev"


def is_prod() -> bool:
    return current_env() == "prod"


def _find_dotenv() -> Path | None:
    """Walk up from CWD looking for a .env file."""
    current = Path.cwd()
    for parent in [current, *current.parents]:
        candidate = parent / ".env"
        if candidate.is_file():
            return candidate
    return None
