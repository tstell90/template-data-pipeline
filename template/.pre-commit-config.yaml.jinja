repos:
  # ── General file hygiene ───────────────────────────────
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v5.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
        args: [--unsafe]
      - id: check-toml
      - id: check-added-large-files
        args: [--maxkb=1000]
      - id: check-merge-conflict
      - id: detect-private-key
      - id: no-commit-to-branch
        args: [--branch, main]

  # ── Ruff: linting + formatting ─────────────────────────
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.11.0
    hooks:
        # `ruff-check` only exists from ruff-pre-commit v0.12; at the rev
        # pinned above the id is `ruff`. Getting this wrong makes
        # pre-commit error on the whole file, so NO hook runs at all —
        # which is exactly what happened in three generated repos.
      - id: ruff
        types_or: [python, pyi]
        args: [--fix]
      - id: ruff-format
        types_or: [python, pyi]

  # ── Mypy: type checking (uses project venv) ────────────
  - repo: local
    hooks:
      - id: mypy
        name: mypy
        entry: uv run mypy src/
        language: system
        types: [python]
        pass_filenames: false

  # ── Secrets ────────────────────────────────────────────
  # Catches credentials assigned to secret-ish names in any language. The
  # detect-private-key hook above only matches PEM blocks.
  #
  # Pinned to an exact tag, deliberately NOT {{ platform_repo_ref }}: that is
  # a floating tag, correct for Actions (which re-resolves every run) but wrong
  # for pre-commit, which caches by rev and never re-clones a mutable
  # reference. Bump with `pre-commit autoupdate`.
  - repo: https://github.com/{{ github_username }}/platform
    rev: v1.4.1
    hooks:
      - id: detect-hardcoded-secrets
