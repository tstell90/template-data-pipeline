{%- if use_terraform %}
terraform {
  required_version = ">= 1.5.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    azuread = {
      source  = "hashicorp/azuread"
    }
    databricks = {
      source  = "databricks/databricks"
      version = "~> 1.0"
    }
  }

  # Remote state in Azure Storage.
  # Initialize with: terraform init -backend-config=environments/dev.backend.hcl
  backend "azurerm" {}
}

provider "azurerm" {
  features {}
  # Authenticates via ARM_* env vars (set in .env or GitHub Secrets)
}

provider "azuread" {}

provider "databricks" {
  # Authenticates via DATABRICKS_HOST and DATABRICKS_TOKEN env vars
}
{%- endif %}
