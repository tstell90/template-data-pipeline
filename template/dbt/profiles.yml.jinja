{%- if use_dbt %}
{{ python_module_name }}:
  target: dev
  outputs:
    dev:
      type: databricks
      catalog: dev
      schema: default
      host: "{{ '{{ env_var(\"DATABRICKS_HOST\") }}' }}"
      http_path: "{{ '{{ env_var(\"DATABRICKS_HTTP_PATH\") }}' }}"
      token: "{{ '{{ env_var(\"DATABRICKS_TOKEN\") }}' }}"
      threads: 4

    prod:
      type: databricks
      catalog: prod
      schema: default
      host: "{{ '{{ env_var(\"DATABRICKS_HOST\") }}' }}"
      http_path: "{{ '{{ env_var(\"DATABRICKS_HTTP_PATH\") }}' }}"
      token: "{{ '{{ env_var(\"DATABRICKS_TOKEN\") }}' }}"
      threads: 4
{%- endif %}
